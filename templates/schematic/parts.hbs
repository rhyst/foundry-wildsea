<section class="wildsea flexcol wildsea-gapped">
  {{#if isGM}}
  <button type="button" data-action="generateSchematic"><i class="fas fa-compass-drafting"></i> {{localize "wildsea.GENERATOR.button"}}</button>
  {{/if}}
  <p class="wildsea-text-muted">{{localize "wildsea.SCHEMATIC.dragHint"}}</p>
  {{#each sections as |section|}}
  <h3 class="wildsea-cut-corners wildsea-bg-mid">{{section.label}}</h3>
  <ul class="wildsea-ship-parts-list">
    {{#each section.parts as |part|}}
    <li class="wildsea-padded wildsea-rounded wildsea-border-thin" draggable="true" data-part-key="{{part.key}}">
      <span>{{part.label}}</span>
      {{#if part.here}}
      <a data-action="locatePart" data-tooltip="{{localize "wildsea.TRACKS.locate"}}"><i class="fas fa-location-dot"></i></a>
      {{/if}}
    </li>
    {{/each}}
  </ul>
  {{/each}}
</section>
