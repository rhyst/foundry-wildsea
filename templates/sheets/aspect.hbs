<div class="wildsea flexcol wildsea-gapped">
  <div id="header" class="flexrow wildsea-gapped">
    <div class="flexrow wildsea-gapped">
      <div class="flex0 wildsea-portrait"><img src="{{item.img}}" data-edit="img" title="{{item.name}}" /></div>
      <div class="flexcol wildsea-gapped">
        <input id="name" class="wildsea-cut-corners" type="text" name="name" value="{{item.name}}" placeholder="{{localize "wildsea.name"}}" />
        <div class="flexrow wildsea-gapped">
          {{> "systems/the-wildsea/templates/shared/text_field.hbs" field="system.type" value=system.type label="wildsea.type"}}
          {{> "systems/the-wildsea/templates/shared/number_field.hbs" field="system.track.max" value=system.track.max label="wildsea.track" min=0 max=8}}
        </div>
      </div>
    </div>
  </div>

  {{#if protections}}
  <section class="wildsea-protections">
    <h3 class="wildsea-cut-corners wildsea-bg-mid" data-action="toggleProtections">
      <i class="wildsea-expander fas fa-caret-{{#if protectionsOpen}}down{{else}}left{{/if}}"></i>
      {{localize "wildsea.DAMAGE.protections"}}
      <small>{{#with (protectionSummary system) as |summary|}}{{summary}}{{else}}{{localize "wildsea.none"}}{{/with}}</small>
    </h3>
    {{#if protectionsOpen}}
    <table>
      <tbody>
        <tr class="wildsea-protection-columns">
          <td></td>
          {{#each protectionKeys as |key|}}
          <th>{{localize (concat "wildsea.DAMAGE.COLUMNS." key)}}</th>
          {{/each}}
        </tr>
        {{#each protections as |row|}}
        <tr>
          <td>{{localize (concat "wildsea.DAMAGE_TYPES." row.type)}}</td>
          {{#each row.cells as |cell|}}
          <td><input type="checkbox" data-protection="{{cell.key}}" data-damage-type="{{row.type}}" {{checked cell.checked}} {{disabled (not @root.editable)}} /></td>
          {{/each}}
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}
  </section>
  {{/if}}

  <div id="body">
    <h3 class="wildsea-cut-corners wildsea-bg-mid">{{localize "wildsea.details"}}</h3>
    {{> "systems/the-wildsea/templates/shared/description.hbs" content=system.enrichedDetails value=system.details target="system.details"}}
  </div>
</div>
