<div class="wildsea flexcol wildsea-gapped">
  <div id="header" class="flexrow wildsea-gapped">
    <div class="flexrow wildsea-gapped">
      <div class="flex0 wildsea-portrait"><img src="{{item.img}}" data-edit="img" title="{{item.name}}" /></div>
      <div class="flexcol wildsea-gapped">
        <input id="name" class="wildsea-cut-corners" type="text" name="name" value="{{item.name}}" placeholder="{{localize "wildsea.name"}}" />
        <div class="flexrow wildsea-gapped">
          {{#if (eq item.type 'design')}}
            {{> "systems/the-wildsea/templates/shared/select_field.hbs" field="system.type" value=system.type label="wildsea.type" selectOptions=config.designTypes}}
          {{else}}
            {{> "systems/the-wildsea/templates/shared/text_field.hbs" field="system.type" value=system.type label="wildsea.type"}}
          {{/if}}
          {{#if hasTrack}}
            {{> "systems/the-wildsea/templates/shared/number_field.hbs" field="system.track.max" value=system.track.max label="wildsea.track" min=0 max=8}}
          {{/if}}
          {{> "systems/the-wildsea/templates/shared/number_field.hbs" field="system.stakes" value=system.stakes label="wildsea.stakes" min=0}}
        </div>
      </div>
    </div>
  </div>

  <div id="body" class="flexcol wildsea-gapped">
    <section class="wildsea-tab-nav">
      <nav class="sheet-tabs tabs flexrow wildsea-gapped" data-group="primary">
        <a data-tab="main">{{localize "wildsea.description"}}</a>
        <a data-tab="ratingMods">{{localize "wildsea.ratingMods"}}</a>
      </nav>
    </section>

    <section class="sheet-body">
      <div class="tab-main tab" data-group="primary" data-tab="main">
        {{> "systems/the-wildsea/templates/shared/description.hbs" content=system.enrichedDetails value=system.details target="system.details"}}
      </div>
      <div class="tab-rating-mods tab" data-group="primary" data-tab="ratingMods">
        {{> "systems/the-wildsea/templates/shared/rating_mods.hbs"}}
      </div>
    </section>
  </div>
</div>
