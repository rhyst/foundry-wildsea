<div class="form-group flexrow">
  <label class="flex1">{{localize label}}</label>
  <div class="form-fields flex3">
    <input type="number" name="{{field}}" value="{{value}}" placeholder="{{#if placeholder}}{{placeholder}}{{else}}{{localize label}}{{/if}}" class="wildsea-cut-corners" min="{{min}}" max="{{max}}" />
  </div>
</div>
